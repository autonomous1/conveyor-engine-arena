{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": []
  },
  "include": [
    "src/client",
    "src/shared",
    "src/util/bake-map-page.ts",
    "src/util/bake-scene.ts",
    "src/util/map-camera.ts"
  ]
}