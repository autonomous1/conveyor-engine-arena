{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": [],
    "baseUrl": ".",
    // Solo's server import chain uses node: builtins. Keep types empty so browser
    // files do not gain Node globals; paths resolve only explicit node: imports.
    "paths": {
      "node:*": ["node_modules/@types/node/*"]
    }
  },
  "include": [
    "src/client",
    "src/shared",
    "src/util/bake-map-page.ts",
    "src/util/bake-scene.ts",
    "src/util/map-camera.ts"
  ]
}