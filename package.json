{
  "name": "conveyor-engine-arena",
  "version": "0.2.1",
  "description": "Browser arena client and authoritative host for Conveyor Engine",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "node scripts/build-client.mjs",
    "build:solo": "node scripts/build-solo.mjs && node scripts/check-web-bundle.mjs solo",
    "check:web": "node scripts/check-web-bundle.mjs web",
    "build": "npm run clean && npm run build:server && npm run build:client && npm run check:web",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.util.json --noEmit",
    "test": "node --test test/*.test.ts",
    "codemap:check": "node scripts/codemap.ts --check",
    "start": "node dist/server/main.js",
    "serve:solo": "node scripts/serve-solo.mjs",
    "start:arena": "node dist/run.js arena",
    "start:arena-wall": "node dist/run.js arena 40",
    "start:arena-miss": "node dist/run.js arena-miss",
    "bake:scene": "scripts/bake.sh",
    "bake:sceneGraph": "scripts/bake-scene-graph.sh",
    "bake:ktx2": "bash scripts/bake-ktx2.sh",
    "bake:map": "node src/util/bake-map.ts",
    "run:lossless": "node dist/run.js lossless",
    "run:lossy": "node dist/run.js lossy",
    "run:partition": "node dist/run.js partition",
    "bench": "node dist/bench-cli.js",
    "token": "node dist/server/auth/token-cli.js",
    "dev": "npm run build && npm run start",
    "codemap": "node scripts/codemap.ts",
    "viewer": "npm run start",
    "live:arena": "npm run start"
  },
  "license": "ISC",
  "dependencies": {
    "conveyor-engine-assets": "^0.2.0",
    "conveyor-engine-client": "^0.1.1",
    "conveyor-engine-core": "^0.1.1",
    "conveyor-engine-example": "^0.2.0",
    "conveyor-engine-replication": "^0.1.1",
    "conveyor-engine-three": "^0.1.1",
    "conveyor-engine-transport-ws": "^0.2.0",
    "conveyor-engine-world": "^0.1.2",
    "jose": "^6.2.15",
    "three": "~0.186.0",
    "three-gamepad-controls": "^0.24.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.14",
    "blueprint-scene": "^0.1.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
