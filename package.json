{
  "name": "conveyor-engine-arena",
  "version": "0.0.1",
  "private": true,
  "description": "Browser arena client and authoritative host for Conveyor Engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.util.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "start": "node dist/server/main.js",
    "dev": "npm run build && npm run start",
    "start:arena": "node dist/run.js arena",
    "start:arena-wall": "node dist/run.js arena 40",
    "start:arena-miss": "node dist/run.js arena-miss",
    "bake:scene": "scripts/bake.sh",
    "bake:map": "node --experimental-strip-types src/util/bake-map.ts",
    "run:lossless": "node dist/run.js lossless",
    "run:lossy": "node dist/run.js lossy",
    "run:partition": "node dist/run.js partition",
    "bench": "node dist/bench-cli.js",
    "viewer": "npm run start",
    "record:arena": "node dist/dev/arena-scenario.js",
    "live:arena": "npm run start"
  },
  "license": "ISC",
  "dependencies": {
    "conveyor-engine-assets": "^0.1.0",
    "conveyor-engine-client":"^0.1.0",
    "conveyor-engine-core": "^0.1.0",
    "conveyor-engine-replication": "^0.1.0",
    "conveyor-engine-three": "^0.1.0",
    "conveyor-engine-transport-ws": "^0.1.0",
    "conveyor-engine-world": "^0.1.0",
    "three": "~0.186.0",
    "three-gamepad-controls": "^0.24.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.14",
    "blueprint-scene": "^0.1.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
